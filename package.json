{
  "name": "obsidian-hcl-terraform-syntax-highlight",
  "version": "0.1.1",
  "private": true,
  "description": "Obsidian plugin that enables HCL/Terraform fenced code block syntax highlighting in the editor.",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lezer/highlight": "^1.2.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@types/node": "^25.5.0",
    "codemirror-lang-hcl": "^0.1.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  }
}
